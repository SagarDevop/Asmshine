# Server Environment (Render sets PORT automatically, but keeping 5000 is good practice)
PORT=5000
NODE_ENV=production

# Frontend Production URL on Vercel (comma-separated if multiple domains)
# Example: https://asm-shine.vercel.app
CLIENT_URL=https://your-app-name.vercel.app

# MongoDB Connection String (Required on Render: use free MongoDB Atlas cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/cleanora?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cleanora?retryWrites=true&w=majority

# Cloudinary Storage for Products & Banners
CLOUDINARY_CLOUD_NAME=dheyj35ys
CLOUDINARY_API_KEY=225322758271885
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# JWT Authentication Secret (Required in production: min 32 random characters)
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=

# Brevo (formerly Sendinblue) Transactional Email Delivery (Recommended - No port blocking)
# Generate your API Key from Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_verified_brevo_sender@domain.com
BREVO_SENDER_NAME=ASM Shine

# Email Delivery for OTP (Legacy SMTP Fallback)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="ASM Shine Hygiene" <no-reply@asmshine.com>
EMAIL_SECURE=false
