# Render Backend Production API URL (leave blank in local development to use Vite proxy)
# Example for Vercel deployment: https://asm-shine-backend.onrender.com
VITE_API_URL=

# Google OAuth 2.0 Client ID (Optional, from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
